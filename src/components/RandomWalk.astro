---
/**
 * Interactive figure: sample paths of a symmetric random walk with a
 * ±2√n envelope. "Draw again" resamples the paths.
 */
interface Props {
  paths?: number;
  steps?: number;
  number?: number;
  compact?: boolean;
}
const { paths = 5, steps = 240, number, compact = false } = Astro.props;
const W = compact ? 480 : 660;
const H = compact ? 300 : 280;
---

<figure class:list={['figure random-walk', { 'caption-margin': !compact }]} data-paths={paths} data-steps={steps} data-w={W} data-h={H}>
  <figcaption>
    {number !== undefined && <b>Figure {number}.&ensp;</b>}
    <slot>
      {compact
        ? 'Five paths of a symmetric random walk. Rescaled, they converge to Brownian motion.'
        : `${paths} paths of a symmetric random walk, ${steps} steps each. The dashed curves mark ±2√n, inside which about 95% of paths lie at each step.`}
    </slot>
  </figcaption>
  <div class="plate">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${paths} sample paths of a symmetric random walk`}>
      <path d={`M0 ${H / 2} H${W}`} style="fill: none; stroke: var(--rule); stroke-width: 1;"></path>
      {!compact && <path class="env-up" style="fill: none; stroke: var(--muted); stroke-width: 1; stroke-dasharray: 3 4;"></path>}
      {!compact && <path class="env-dn" style="fill: none; stroke: var(--muted); stroke-width: 1; stroke-dasharray: 3 4;"></path>}
      {Array.from({ length: paths }, (_, i) => (
        <path
          class="walk"
          style={i === 0
            ? 'fill: none; stroke: var(--accent); stroke-width: 1.6;'
            : 'fill: none; stroke: var(--muted); stroke-width: 1; opacity: 0.5;'}
        ></path>
      ))}
    </svg>
    {!compact && (
      <div class="controls">
        <button type="button" class="textbtn">Draw again</button>
      </div>
    )}
  </div>
</figure>

<script>
  function draw(fig: HTMLElement) {
    const n = Number(fig.dataset.paths);
    const steps = Number(fig.dataset.steps);
    const W = Number(fig.dataset.w);
    const H = Number(fig.dataset.h);
    const sc = H / 2 / (2.6 * Math.sqrt(steps));
    fig.querySelectorAll<SVGPathElement>('path.walk').forEach((p) => {
      let y = 0;
      let d = `M0 ${H / 2}`;
      for (let i = 1; i <= steps; i++) {
        y += Math.random() < 0.5 ? -1 : 1;
        const yy = Math.max(3, Math.min(H - 3, H / 2 - y * sc));
        d += ` L${((i * W) / steps).toFixed(1)} ${yy.toFixed(1)}`;
      }
      p.setAttribute('d', d);
    });
    const up = fig.querySelector('.env-up');
    const dn = fig.querySelector('.env-dn');
    if (up && dn) {
      let u = `M0 ${H / 2}`;
      let l = `M0 ${H / 2}`;
      for (let i = 2; i <= steps; i += 2) {
        const x = ((i * W) / steps).toFixed(1);
        const e = 2 * Math.sqrt(i) * sc;
        u += ` L${x} ${(H / 2 - e).toFixed(1)}`;
        l += ` L${x} ${(H / 2 + e).toFixed(1)}`;
      }
      up.setAttribute('d', u);
      dn.setAttribute('d', l);
    }
  }

  document.querySelectorAll<HTMLElement>('.random-walk').forEach((fig) => {
    draw(fig);
    fig.querySelector('button')?.addEventListener('click', () => draw(fig));
  });
</script>
