---
import type { Project } from '../lib/content';
import TagList from './TagList.astro';

interface Props {
  project: Project;
  compact?: boolean;
}
const { project, compact = false } = Astro.props;
const { title, summary, year, stack, cover, coverAlt, tags, links } = project.data;
const href = `/projects/${project.id}/`;
const Heading = compact ? 'h3' : 'h2';
---

<article class="card">
  <a class="cover plain" href={href} tabindex="-1" aria-hidden="true">
    {cover && <img src={cover} alt={coverAlt} loading="lazy" decoding="async" />}
  </a>
  <div class="card-head">
    <Heading><a class="plain" href={href}>{title}</a></Heading>
    <p class="meta" style="margin: 0;">{year} · {stack}</p>
  </div>
  <p class="summary">{summary}</p>
  {!compact && <TagList tags={tags} />}
  {
    !compact && (
      <div class="links">
        <a href={href}>Write-up</a>
        {links.demo && <a href={links.demo}>Demo</a>}
        {links.code && <a href={links.code}>Code</a>}
        {links.paper && <a href={links.paper}>Paper</a>}
      </div>
    )
  }
</article>
