---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <div class="wrap page" style="padding-bottom: 48px;">
    <header class="page-head">
      <p class="label" style="margin: 0 0 16px; color: var(--accent);">Error 404</p>
      <h1>Nothing is conserved here.</h1>
      <p>The page you were looking for doesn’t exist. Try the <a href="/">front page</a> or <a href="/search/">search</a>.</p>
    </header>
  </div>
</Base>
