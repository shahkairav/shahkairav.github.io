---
import Base from '../../layouts/Base.astro';
import { getEssays, getNotes, getProjects, slugify } from '../../lib/content';

const [essays, notes, projects] = await Promise.all([getEssays(), getNotes(), getProjects()]);
const counts = new Map<string, { name: string; n: number }>();
[...essays, ...notes, ...projects].forEach((e) =>
  e.data.tags.forEach((t: string) => {
    const s = slugify(t);
    counts.set(s, { name: t, n: (counts.get(s)?.n ?? 0) + 1 });
  }),
);
const tags = [...counts.entries()].sort((a, b) => a[1].name.localeCompare(b[1].name));
---

<Base title="Tags">
  <div class="wrap page">
    <header class="page-head">
      <h1>Tags</h1>
      <p>Every subject filed across essays, notes and projects.</p>
    </header>
    <ul style="list-style: none; margin: 0; padding: 0; max-width: 860px; columns: 3 220px; column-gap: 48px;">
      {
        tags.map(([slug, { name, n }]) => (
          <li style="break-inside: avoid; padding: 10px 0; border-bottom: 1px solid var(--rule); display: flex; justify-content: space-between; gap: 12px;">
            <a class="plain" href={`/tags/${slug}/`} style="font-size: 19px; color: var(--ink);">{name}</a>
            <span class="meta">{n}</span>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
